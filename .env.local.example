# URL of the SoulWeave app users are redirected to after the funnel (free access, or after buying the PDF report)
NEXT_PUBLIC_APP_URL=https://soulweave-family-map.lovable.app

# Google Sheets integration (see README for setup steps)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key, keeping the \n escapes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Stripe (see README for setup steps) — used to charge for the full PDF report
STRIPE_SECRET_KEY=sk_test_...
# From Dashboard → Developers → Webhooks, after adding an endpoint for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: override the blended processing + currency-conversion fee assumption
# used to gross up the price so you always net R$27,00 after Stripe's cut.
# Check your real blended rate at https://dashboard.stripe.com/settings/billing and tune these if needed.
# STRIPE_FEE_PERCENT=0.0399
# STRIPE_FEE_FIXED_CENTS_BRL=39
# STRIPE_FEE_FIXED_CENTS_USD=30

# Resend (see README for setup steps) — used to email the PDF report
RESEND_API_KEY=re_...
# Must be on a domain you've verified in Resend. Falls back to the shared
# Resend sandbox sender (onboarding@resend.dev) if unset, which only
# delivers to your own Resend account email — fine for testing, not for real customers.
RESEND_FROM_EMAIL="SoulWeave <relatorio@yourdomain.com>"
